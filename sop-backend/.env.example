# ---------------------------------------------------------------------
# .env.example — 환경변수 견본
#
# 이 파일을 복사해서 .env 로 이름을 바꾸고 값을 채웁니다.  (cp .env.example .env)
# .env 는 비밀번호가 들어가므로 git 에 올리지 않습니다 (.gitignore 에 이미 등록).
#
# 로컬 실행 시 적용하는 법 (zsh/bash):   set -a; source .env; set +a
# 그 다음:                               uvicorn app.main:app --reload
# (app/config.py 가 이 이름들을 읽습니다. 전부 선택 사항이며 비우면 기본값)
# ---------------------------------------------------------------------

# ===== DB 접속 (아래 둘 중 하나만 쓰면 됩니다) =====

# 방법 1) 접속 주소 한 줄.  형식: postgresql://계정:비밀번호@주소:포트/DB이름   ← 있으면 이것이 최우선
#         회사 DB 가 암호화 접속(SSL)을 요구하면 끝에 ?sslmode=require 를 붙입니다.
#         예) DATABASE_URL=postgresql://sop_app:비밀번호@db.company.local:5432/sop?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sop

# 방법 2) 회사 DB 처럼 항목별로 줄 때. DATABASE_URL 을 비우고 PGHOST 를 채우면 이 다섯 개로 조립합니다.
#         (비밀번호에 @ / 같은 특수문자가 있어도 그대로 적으면 됩니다)
# PGHOST=db.company.local
# PGPORT=5432
# PGUSER=sop_app
# PGPASSWORD=비밀번호
# PGDATABASE=sop
# 회사 DB 가 SSL 을 요구하면 ("no pg_hba.conf entry ... SSL off" 오류가 나면) 아래 두 줄. DB 드라이버가 직접 읽는 표준 이름입니다.
# PGSSLMODE=require
# PGSSLROOTCERT=/path/to/company-ca.crt     # 회사 인증서로 서버를 검증해야 할 때만 (verify-ca / verify-full 과 함께)

# ===== DB 세부 =====

# 연결마다 붙이는 세션 옵션. 기본은 시각을 UTC 로 받는 설정.
# PgBouncer 같은 중계기가 options 를 거부하면 빈 값("")으로 두세요. (서버 응답 시각은 어차피 UTC(Z) 로 나갑니다)
DB_SESSION_OPTIONS=-c timezone=UTC

# 같은 SQL 을 몇 번 실행하면 DB 서버에 "미리 준비된 문장(prepared statement)" 으로 등록할지. (기본 5)
# PgBouncer 트랜잭션 풀링 뒤에서는 이 등록이 깨져 "prepared statement ... does not exist" 오류가 날 수 있으니 0 으로 끄세요.
DB_PREPARE_THRESHOLD=5

# PgBouncer 뒤에서 쓸 때 한 번에 바꿀 것 (요약):
#   DB_SESSION_OPTIONS=""      ← options 거부 대응
#   DB_PREPARE_THRESHOLD=0     ← prepared statement 끄기
#   PgBouncer 는 1.21 이상이어야 합니다. (저장 때 노드/연결선을 한꺼번에 넣는 방식(파이프라인)을 그 이하 버전은 못 받습니다)

# DB 접속을 기다리는 최대 시간(초). 이 시간 안에 접속이 안 되면 서버가 원인을 로그에 남기고 종료합니다. (기본 30)
DB_CONNECT_TIMEOUT=30

# 연결 풀 크기: 미리 열어 두는 연결 최소/최대 개수. (기본 2 / 10. DB 의 max_connections 를 넘지 않게)
DB_POOL_MIN=2
DB_POOL_MAX=10

# ===== 서버 =====

# 서버가 "/sop" 같은 경로 접두어 뒤에서 돌 때 그 접두어. 접두어 없이 바로 뜨면 비워 둡니다. (기본 "")
ROOT_PATH=

# 사용자 이름이 들어오는 HTTP 헤더 이름. 회사 SSO 프록시가 넣어 주는 헤더 이름으로 바꿉니다. (기본 X-User)
USER_HEADER=X-User

# 로그 상세 정도: DEBUG / INFO / WARNING / ERROR (기본 INFO)
LOG_LEVEL=INFO

# 컨테이너에서 서버가 열 포트 (Dockerfile 이 읽음. 기본 8000)
PORT=8000

# 편집기 HTML 을 이 서버가 아닌 다른 주소(예: 사내 웹서버)에서 띄울 때만 그 주소를 적습니다.
# 여러 개면 쉼표로 구분.  같은 서버(http://localhost:8000)에서 열면 비워 둡니다.
CORS_ORIGINS=

# 편집기 HTML 파일이 들어 있는 폴더 (기본값 static)
STATIC_DIR=static

# 그 폴더 안에서 "/" 로 접속했을 때 보여 줄 파일 이름 (기본값 SOP_STUDIO.html)
STATIC_INDEX=SOP_STUDIO.html

# 저장 요청 한 건의 최대 크기(MB). 이미지가 base64 로 들어가서 큽니다. 넘으면 413 오류. (기본값 20)
MAX_CONTENT_MB=20

# ===== 테스트 전용 (선택) =====
# pytest 가 쓸 별도 DB. 비워 두면 내장 PostgreSQL(pgserver)을 자동으로 씁니다.
# 주의: 여기 적은 DB 의 테이블은 테스트가 지우고 다시 만듭니다. 운영 DB 를 절대 적지 마세요.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sop_test
